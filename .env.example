# ── Supabase (Edge Function + Postgres) ──────────────────────────
# Project API URL, e.g. https://<ref>.supabase.co
SUPABASE_URL="https://<ref>.supabase.co"
# Service role key for the backend-to-database admin client. KEEP SECRET.
# (The Edge Function also auto-injects SUPABASE_URL + SUPABASE_ANON_KEY at runtime.)
SUPABASE_SERVICE_ROLE_KEY=""
# Postgres connection string used ONLY for Prisma migrations/seeds.
# Use the direct connection (port 5432), sslmode=require.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────
# Shared HS256 secret for the custom JWT (same value the Express server used).
JWT_SECRET="generate-a-strong-random-secret"

# ── Password reset email (SMTP) ───────────────────────────────────
# Required for POST /api/auth/forgot-password to work. While any of SMTP_HOST,
# MAIL_FROM or APP_URL is empty — or only one half of the credential pair is
# set — the endpoint returns 503 and issues NO reset token. It fails closed
# rather than handing the token back in the response body.
# Any provider with an SMTP submission endpoint works (Gmail app password,
# Fastmail, Postmark, Amazon SES, Mailgun, a local relay, ...).
SMTP_HOST="smtp.yourprovider.com"
# Submission port. 587 is STARTTLS, 465 is implicit TLS. Defaults to 587.
SMTP_PORT="587"
# Leave BOTH empty for an open relay on a trusted network. Setting only one is
# treated as a misconfiguration and disables email entirely.
SMTP_USER=""
# KEEP SECRET.
SMTP_PASS=""
# Set to true for implicit TLS (port 465). Left empty, it is inferred from the
# port. When false, the client REFUSES to authenticate unless the server
# advertises STARTTLS, so credentials are never sent in the clear.
SMTP_SECURE=""
# Verified sender, e.g. "Lost & Found <no-reply@yourdomain.com>"
MAIL_FROM="Lost & Found <no-reply@example.com>"
# Public origin of the React app. The emailed link is
# <APP_URL>/reset-password?token=... so this must match where the client is served.
APP_URL="http://localhost:5173"

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS="http://localhost:5173,https://<your-new-vercel-domain>.vercel.app"

# ── Cloudinary ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Frontend (Vite) ──────────────────────────────────────────────
# Client API base URL. Local dev while serving the function:
#   http://127.0.0.1:54321/functions/v1/api
# Production on Vercel:
#   https://<ref>.supabase.co/functions/v1/api
VITE_API_URL="http://127.0.0.1:54321/functions/v1/api"

# ── ML image matching (OPTIONAL) ──────────────────────────────────
# The Python DINOv2 service is optional. Leave LEFTBEHIND_ML_SERVICE_URL empty
# and the API matches on metadata only; nothing else changes.
# Internal URL of the FastAPI service, no trailing slash. Must be reachable
# from the Edge Function. Local dev, with `uvicorn app:app --port 8001`:
#   http://127.0.0.1:8001
LEFTBEHIND_ML_SERVICE_URL=
# Per-request timeout in ms. Must exceed one ML round trip (measured 1.2-2.5s
# with warm DINOv2 over the public internet).
LEFTBEHIND_ML_TIMEOUT_MS=5000
# Whole-operation budget in ms for the image-evidence phase of ONE match run.
# Bounds total wait: at concurrency 2, 10 imaged candidates is 5 waves, so the
# per-request timeout alone does not cap report-creation latency. Unset, zero,
# negative or non-numeric values fall back to 5000.
LEFTBEHIND_ML_MATCHING_DEADLINE_MS=5000
