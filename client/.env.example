# Copy to .env.local and adjust. Vite only exposes vars prefixed with VITE_.
# No localhost backend exists: Docker is not installed, so `supabase functions serve`
# is unavailable and the dev server talks to the deployed Edge Function directly.
# The function's ALLOWED_ORIGINS must include http://localhost:5173.

# Local dev (deployed function, live data)
VITE_API_URL=https://cuhngnehtlswsdemsdpr.supabase.co/functions/v1/api

# Production (Vercel) — set in the Vercel project's environment variables:
# VITE_API_URL=https://cuhngnehtlswsdemsdpr.supabase.co/functions/v1/api
